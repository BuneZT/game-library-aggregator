# Copy this file to `.env` and fill in your free API credentials.

# 1. IGDB / Twitch Developer credentials (free, required for Critic Scores, Genres & Themes)
#    Create an app at https://dev.twitch.tv/console/apps (Redirect URL can be http://localhost)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# 2. Steam Web API key (recommended — pulls your ENTIRE owned Steam backlog, not just installed games)
#    Get a free key at https://steamcommunity.com/dev/apikey (Domain Name can be localhost)
#    Note: Your Steam Profile's "Game details" privacy setting must be set to Public.
STEAM_API_KEY=

# Optional: Your 17-digit SteamID64. Leave blank to auto-detect from local Steam loginusers.vdf!
STEAM_ID=

# Optional path overrides (auto-detected by default)
# HEROIC_CONFIG_DIR=~/.var/app/com.heroicgameslauncher.hgl/config/heroic
# STEAM_DIR=~/.local/share/Steam
